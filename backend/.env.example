# Server Configuration
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/moneywise?retryWrites=true&w=majority

# Local MongoDB alternative:
# MONGO_URI=mongodb://127.0.0.1:27017/moneywise

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
